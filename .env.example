# Local HTTP only binds loopback. Remote use: switch PUBLIC_URL to HTTPS and supply tls.crt/tls.key.
PUBLIC_URL=http://localhost:8080
HTTP_BIND_ADDRESS=127.0.0.1
HTTPS_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# For TLS: see docs/installation/index.md, compose --profile tls --profile operations.
SECRETS_DIR=./.secrets
BACKUP_DIR=./backups
MIN_SEVERITY=HIGH
