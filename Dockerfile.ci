# SPDX-License-Identifier: Apache-2.0
# Job image of the GitLab CI template: Syft plus the PatchWatch CI module, no network downloads at job time.
FROM anchore/syft:v1.57.1 AS syft
FROM docker:29.9.3-cli@sha256:5a7af0dcb0e46c803efe9b45371dd21cb500e5b4453250394ac6f06d49b6e6f1 AS docker-cli

FROM python:3.14.0-alpine3.22
LABEL org.opencontainers.image.title="Patchwatch CI" \
      org.opencontainers.image.licenses="Apache-2.0"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 SYFT_CHECK_FOR_APP_UPDATE=false
# Git computes an actual three-way merge; Docker builds both sides when requested.
RUN apk add --no-cache git ca-certificates
RUN pip install --no-cache-dir jsonschema==4.25.1
# Alpine 3.22 docker-cli embeds an old Go runtime; use the patched official CLI binary.
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=syft /syft /usr/local/bin/syft
# Outside the workspace: python -m must never pick up a patchwatch/ directory of the scanned repository.
COPY patchwatch /opt/patchwatch/patchwatch
WORKDIR /opt/patchwatch
