{
  "policies": [
    {
      "name": "Patchwatch severity High or Critical",
      "operator": "ANY",
      "violationState": "FAIL",
      "scopeTags": [
        "managed-by:patchwatch"
      ],
      "conditions": [
        {
          "subject": "SEVERITY",
          "operator": "IS",
          "value": "HIGH"
        },
        {
          "subject": "SEVERITY",
          "operator": "IS",
          "value": "CRITICAL"
        }
      ]
    },
    {
      "name": "Patchwatch unresolved license review",
      "operator": "ANY",
      "violationState": "WARN",
      "scopeTags": [
        "managed-by:patchwatch"
      ],
      "conditions": [
        {
          "subject": "LICENSE",
          "operator": "IS",
          "value": "unresolved"
        }
      ]
    },
    {
      "name": "Patchwatch EPSS at least 10 percent",
      "operator": "ANY",
      "violationState": "WARN",
      "scopeTags": [
        "managed-by:patchwatch"
      ],
      "conditions": [
        {
          "subject": "EPSS",
          "operator": "NUMERIC_GREATER_THAN_OR_EQUAL",
          "value": "0.1"
        }
      ]
    },
    {
      "name": "Patchwatch distribution license approval",
      "operator": "ANY",
      "violationState": "WARN",
      "scopeTags": [
        "policy-profile:distribution"
      ],
      "conditions": [
        {
          "subject": "LICENSE_GROUP",
          "operator": "IS_NOT",
          "value": "Patchwatch distribution baseline"
        }
      ]
    },
    {
      "name": "Patchwatch blocked xz upstream releases",
      "operator": "ANY",
      "violationState": "FAIL",
      "scopeTags": [
        "managed-by:patchwatch"
      ],
      "conditions": [
        {
          "subject": "PACKAGE_URL",
          "operator": "MATCHES",
          "value": "^pkg:(deb/[^/]+/(xz-utils|liblzma5)|rpm/[^/]+/(xz|xz-libs)|generic/xz)@5[.]6[.][01](-[0-9][A-Za-z0-9._~]{0,})?([?#].{0,})?$"
        }
      ]
    },
    {
      "name": "Patchwatch direct dependency major version lag",
      "operator": "ANY",
      "violationState": "WARN",
      "scopeTags": [
        "source:gitlab-ci"
      ],
      "conditions": [
        {
          "subject": "VERSION_DISTANCE",
          "operator": "NUMERIC_GREATER_THAN",
          "value": "{\"epoch\":\"0\",\"major\":\"1\",\"minor\":\"?\",\"patch\":\"?\"}"
        }
      ]
    }
  ]
}
